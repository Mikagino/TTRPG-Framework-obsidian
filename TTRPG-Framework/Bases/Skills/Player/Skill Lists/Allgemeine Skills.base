filters:
  and:
    - file.inFolder("TTRPG-Framework/Bases/Skills/Player/Allgemein")
views:
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Eigenschaft
      - Kosten
      - Anfänger
      - Fortgeschritten
      - Experte
    sort:
      - property: Eigenschaft
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 215
      note.Anfänger: 703
