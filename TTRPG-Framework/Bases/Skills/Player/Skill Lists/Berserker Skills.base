filters:
  and:
    - file.inFolder("TTRPG-Framework/Bases/Skills/Player/Berserker")
views:
  - type: notion-board
    name: Notion Board
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Eigenschaft
      - Anfänger
      - Fortgeschritten
      - Experte
    pillProperties:
      - Eigenschaft
    boardColumnWidth: large
    pinnedColors:
      - x=gray
      - GE=orange
      - ST=red
      - WN=blue
      - CH=pink
      - WI=purple
      - WK=brown
  - type: table
    name: Table
    groupBy:
      property: file.folder
      direction: ASC
    order:
      - file.name
      - Eigenschaft
      - Kosten
      - Anfänger
      - Fortgeschritten
      - Experte
    sort:
      - property: Eigenschaft
        direction: ASC
      - property: file.name
        direction: ASC
    columnSize:
      file.name: 215
      note.Anfänger: 204
